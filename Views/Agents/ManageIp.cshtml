@model ManageIpViewModel
@{
    var heading = Model.IsAllUsers ? "Manage IP for All Users" : $"Manage IP for {Model.Username} User";
    var action = Model.IsAllUsers ? "UpdateAllIps" : "ManageIp";
    ViewData["Title"] = heading;
    ViewData["ActiveNav"] = "agents";
}

<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span>/</span>
    <a asp-action="Index">Agent List</a>
    <span>/</span>
    <span>@heading</span>
</nav>

<header class="page-header">
    <h2>@heading</h2>
</header>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="form-section">
    <header class="form-section-header">@heading</header>
    <div class="p-4">
        <form asp-action="@action" method="post"
              onsubmit="@(Model.IsAllUsers ? "return confirm('This will replace the allowed IPs of ALL agents. Continue?');" : "")">

            @if (!Model.IsAllUsers)
            {
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Username" />
            }

            @if (Model.IsAllUsers)
            {
                <div class="alert alert-warning py-2" style="max-width:700px">
                    ⚠️ The IPs entered here will <strong>replace</strong> the existing allowed IPs of every agent (except Super Admin).
                </div>
            }

            <div class="mb-3" style="max-width:700px">
                <label asp-for="AllowedIps" class="form-label fw-bold">
                    Allowed IP Address <span class="text-danger">*</span>
                </label>
                <textarea asp-for="AllowedIps" class="form-control" rows="6"
                          style="font-family:Consolas,monospace;font-size:15px;resize:vertical;min-height:140px"
                          placeholder="49.204.159.2,103.21.45.10"></textarea>
                <div class="form-text">
                    Please enter comma separated values, e.g.: 123.12.23.123,99.45.55.123
                </div>
                <span asp-validation-for="AllowedIps" class="text-danger d-block mt-1"></span>
            </div>

            <div class="d-flex gap-2 group-btns">
                <button type="submit" class="btn btn-primary px-4">UPDATE</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
            </div>
        </form>
    </div>
</section>