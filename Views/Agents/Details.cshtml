@model AgentDetailsViewModel
@{
    var a = Model.Agent;
    ViewData["Title"] = "Agent Profile";
    ViewData["ActiveNav"] = "agents";

    void Field(string label, string? value)
    {
        <div class="form-field">
            <label>@label</label>
            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</div>
        </div>
    }
}

<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span>/</span>
    <a asp-action="Index">Agent List</a>
    <span>/</span>
    <span>@a.Username</span>
</nav>

<header class="page-header d-flex justify-content-between align-items-center">
    <h2>
        @($"{a.FirstName} {a.LastName}".Trim())
        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") fs-6 align-middle">
            @(Model.IsActive ? "Active" : "In-Active")
        </span>
    </h2>
    <div class="d-flex gap-2">
        <a asp-action="AgentForm" asp-route-id="@a.UserId" class="btn btn-info text-white">✏️ Edit</a>
        <a asp-action="Index" class="btn btn-dark">Back to List</a>
    </div>
</header>

<section class="form-section">
    <header class="form-section-header">Login Details</header>
    <div class="form-grid">
        @{
            Field("Username", a.Username);
        }
        @{
            Field("Password", Model.Password);
        }
        @{
            Field("Type", a.UserType);
        }
        @{
            Field("Dialer ID", a.DialerId);
        }
        @{
            Field("Created Date", Model.CreatedDate);
        }
    </div>
</section>

<section class="form-section">
    <header class="form-section-header">Personal Information</header>
    <div class="form-grid">
        @{
            Field("First Name", a.FirstName);
        }
        @{
            Field("Last Name", a.LastName);
        }
        @{
            Field("Phone Number", a.Phone);
        }
        @{
            Field("Email ID", a.Email);
        }
        @{
            Field("Date of Birth", a.Dob);
        }
        @{
            Field("Gender", a.Sex == 1 ? "Female" : "Male");
        }
    </div>
</section>

<section class="form-section">
    <header class="form-section-header">Phone Lines</header>
    <div class="form-grid">
        @{
            Field("Toll Free No", a.TollFreeNo);
        }
        @{
            Field("Direct Line", a.DirectLine);
        }
        @{
            Field("Extn", a.Extn);
        }
    </div>
</section>

<section class="form-section">
    <header class="form-section-header">Address</header>
    <div class="form-grid">
        @{
            Field("Address", a.Address);
        }
        @{
            Field("City", a.City);
        }
        @{
            Field("State", a.State);
        }
        @{
            Field("Zip Code", a.ZipCode);
        }
        @{
            Field("Country", AgentFormViewModel.Countries.GetValueOrDefault(a.Country, a.Country));
        }
    </div>
</section>

<section class="form-section">
    <header class="form-section-header">Allowed IPs</header>
    <div class="p-3">
        @if (Model.AllowedIps.Count == 0)
        {
            <span class="text-muted">No IPs assigned</span>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var ip in Model.AllowedIps)
                {
                    <span class="badge bg-light text-dark border">@ip</span>
                }
            </div>
        }
    </div>
</section>