@model IReadOnlyList<TeamOption>
@{
    ViewData["Title"] = "Teams";
    ViewData["ActiveNav"] = "attendance-teams";
    var leads = ViewBag.Leads as IReadOnlyList<EmployeeOption> ?? [];
}

<nav class="breadcrumb" aria-label="Breadcrumb">Attendance&nbsp;/&nbsp;Teams</nav>

@if (TempData["AttendanceSuccess"] is string ok)
{
    <div class="success-alert">@ok</div>
}
@if (TempData["AttendanceError"] is string err)
{
    <div class="alert">@err</div>
}

<header class="page-header">
    <h2>Teams</h2>
    <p>Assign employees to a team so leads can see their attendance</p>
</header>

<section class="panel" style="margin-bottom: 20px;">
    <h3>Create team</h3>
    <form asp-action="CreateTeam" method="post" class="filters">
        @Html.AntiForgeryToken()
        <input name="name" placeholder="Team name" required />
        <select name="leadEmployeeId">
            <option value="">Lead (optional)</option>
            @foreach (var l in leads)
            {
                <option value="@l.EmployeeId">@l.Display</option>
            }
        </select>
        <button type="submit" class="btn primary">Add team</button>
    </form>
</section>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th width="5%">Id</th>
                <th width="90%">Name</th>
                <th width="5%"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.TeamId</td>
                <td>@t.Name</td>
                <td>
                    @if (AttendanceAccess.CanManageAllRosters(User))
                    {
                            <a class="link" asp-controller="Roster" asp-action="TeamSchedule" asp-route-teamId="@t.TeamId"><i class="fa-regular fa-calendar-days" style="font-size: 18px;"></i></a>
                    }
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="3" class="muted">No teams yet.</td></tr>
        }
        </tbody>
    </table>
</div>
