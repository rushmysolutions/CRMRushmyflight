@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "dashboard";

    var given = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value?.Trim();
    var surname = User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value?.Trim();
    var displayName = string.Join(" ", new[] { given, surname }.Where(s => !string.IsNullOrWhiteSpace(s)));
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = User.Identity?.Name ?? "there";
    }

    var hour = DateTime.Now.Hour;
    var greeting = hour switch
    {
        < 12 => "Good morning",
        < 17 => "Good afternoon",
        _ => "Good evening"
    };
}
<section class="welcome-banner">
    <div class="welcome-copy">
        <p class="welcome-kicker">@greeting</p>
        <h2>Welcome, @displayName</h2>
      @*   <p class="welcome-sub">You’re signed in to Rush My Bookings. Use the sidebar to open any module.</p> *@
    </div>
    <div class="welcome-meta">
        <div class="welcome-date">@DateTime.Now.ToString("dddd")</div>
        <div class="welcome-day">@DateTime.Now.ToString("dd MMM yyyy")</div>
    </div>
</section>
