@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActiveNav"] = "change-password";
}

<nav class="breadcrumb" aria-label="Breadcrumb">Account&nbsp;/&nbsp;Change Password</nav>

<header class="page-header">
    <h2>Change password</h2>
    <p>
        @if (Model.CanChangeAnyone)
        {
            <text>As System Administrator you can reset any employee’s password. Changing your own still needs your current password.</text>
        }
        else
        {
            <text>Update your Internal login password.</text>
        }
    </p>
</header>

@if (TempData["PasswordSuccess"] is string ok)
{
    <div class="success-alert">@ok</div>
}

<section class="form-section" style="max-width: 480px;">
    <form method="post" asp-action="ChangePassword">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert"></div>

        @if (Model.CanChangeAnyone)
        {
            <div class="form-field">
                <label asp-for="EmployeeId"></label>
                <select asp-for="EmployeeId" id="employeeId">
                    @foreach (var e in Model.Employees)
                    {
                        if (Model.EmployeeId == e.EmployeeId)
                        {
                            <option value="@e.EmployeeId" selected>@e.Display</option>
                        }
                        else
                        {
                            <option value="@e.EmployeeId">@e.Display</option>
                        }
                    }
                </select>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="EmployeeId" />
            @if (!string.IsNullOrEmpty(Model.TargetDisplay))
            {
                <p class="muted" style="margin-top:0;">@Model.TargetDisplay</p>
            }
        }

        <div class="form-field" id="currentPasswordField" style="@(Model.ChangingOwn ? null : "display:none")">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <div style="margin-top: 18px; display: flex; gap: 10px;">
            <button type="submit" class="btn primary">Change password</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.CanChangeAnyone)
    {
        <script>
            (function () {
                var selfId = @AttendanceAccess.GetEmployeeId(User);
                var sel = document.getElementById('employeeId');
                var cur = document.getElementById('currentPasswordField');
                if (!sel || !cur) return;
                function sync() {
                    var own = String(sel.value) === String(selfId);
                    cur.style.display = own ? '' : 'none';
                }
                sel.addEventListener('change', sync);
                sync();
            })();
        </script>
    }
}
