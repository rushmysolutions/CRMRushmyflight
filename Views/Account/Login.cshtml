@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutLogin";
}
@if (ViewData["IpWarning"] is string ipWarn)
{
    <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
        <span>⚠️</span>
        <div><strong>Access blocked.</strong> @ipWarn</div>
    </div>
}
<div class="login-card">
    <div class="login-brand">
        <span class="brand-mark">RM</span>
        <div>
            <h1>Rush My Bookings</h1>
            <p>Select portal and sign in</p>
        </div>
    </div>

    <form asp-action="Login" method="post" id="loginForm">
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="InstalledApp" id="installedApp" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Portal"></label>
        <select asp-for="Portal" class="login-portal">
            <option value="@LoginPortals.Crm">CRM — Bookings</option>
            <option value="@LoginPortals.Internal">Internal</option>
        </select>
        <span asp-validation-for="Portal" class="field-validation-error"></span>

        <label asp-for="Login"></label>
        <input asp-for="Login" autocomplete="username" placeholder="Username or email" />

        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" placeholder="Password" />

        <label class="remember" id="rememberRow">
            <input asp-for="RememberMe" id="rememberMe" />
            <span asp-for="RememberMe"></span>
        </label>
        <p class="login-install-note" id="installStayNote" hidden>
            Installed app — you’ll stay signed in until you sign out.
        </p>

        <button type="submit" class="primary login-btn">Sign in</button>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var installed = window.matchMedia('(display-mode: standalone)').matches
                || window.navigator.standalone === true;
            if (!installed) return;

            var flag = document.getElementById('installedApp');
            if (flag) flag.value = 'true';

            var rem = document.getElementById('rememberMe');
            if (rem) rem.checked = true;

            var row = document.getElementById('rememberRow');
            if (row) row.hidden = true;

            var note = document.getElementById('installStayNote');
            if (note) note.hidden = false;
        })();
    </script>
}
