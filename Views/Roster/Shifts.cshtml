@model IReadOnlyList<ShiftListItem>
@{
    ViewData["Title"] = "Shifts";
    ViewData["ActiveNav"] = "attendance-roster";
}

<nav class="breadcrumb" aria-label="Breadcrumb">Attendance&nbsp;/&nbsp;Roster&nbsp;/&nbsp;Shifts</nav>

@if (TempData["AttendanceSuccess"] is string ok)
{
    <div class="success-alert">@ok</div>
}
@if (TempData["AttendanceError"] is string err)
{
    <div class="alert">@err</div>
}

<header class="page-header row">
    <div>
        <h2>Shifts</h2>
        <p>Day and night timings. Night shifts use the <strong>start day</strong> as the attendance date; opt-in stays open until end (cutoff).</p>
    </div>
    <a class="btn" asp-action="Index">Back to roster</a>
</header>

<section class="panel" style="margin-bottom: 20px;">
    <h3>Add shift</h3>
    <form asp-action="CreateShift" method="post" class="filters">
        @Html.AntiForgeryToken()
        <input name="name" placeholder="Name (e.g. Night Sales)" required />
        <input name="startTime" type="time" value="22:00" required title="Start" />
        <input name="endTime" type="time" value="07:00" required title="End / cutoff" />
        <button type="submit" class="btn primary">Add</button>
    </form>
    <p class="muted" style="margin-top:8px;">If end is earlier than start (e.g. 22:00–07:00), it is treated as a night shift.</p>
</section>

<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Start</th>
                <th>End</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td colspan="5" style="padding: 10px 14px;">
                    <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; width:100%;">
                        <form id="shift-edit-@s.ShiftId" asp-action="UpdateShift" method="post"
                              style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; flex:1 1 auto; margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="shiftId" value="@s.ShiftId" />
                            <input name="name" value="@s.Name" required style="min-width:140px;" />
                            <input name="startTime" type="time" value="@s.StartTime.ToString(@"hh\:mm")" required title="Start" />
                            <input name="endTime" type="time" value="@s.EndTime.ToString(@"hh\:mm")" required title="End" />
                            <span class="muted">@(s.IsActive ? "Active" : "Inactive")@(s.CrossesMidnight ? " · night" : "")</span>
                        </form>
                        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-left:auto;">
                            <button type="submit" form="shift-edit-@s.ShiftId" class="btn primary">Save</button>
                            <form asp-action="SetShiftActive" method="post" class="inline-form" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                <input type="hidden" name="isActive" value="@(!s.IsActive)" />
                                <button type="submit" class="btn">@(s.IsActive ? "Deactivate" : "Activate")</button>
                            </form>
                            <form asp-action="DeleteShift" method="post" class="inline-form" style="margin:0;"
                                  onsubmit="return confirm('Delete shift @s.Name? Teams/employees using it will have no shift set.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                <button type="submit" class="btn" style="color:var(--danger);">Delete</button>
                            </form>
                        </div>
                    </div>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="muted">No shifts yet.</td></tr>
        }
        </tbody>
    </table>
</div>
