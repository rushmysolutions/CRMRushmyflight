@model IReadOnlyList<LatestCommentItem>
@{
    ViewData["Title"] = "Latest Comments";
    ViewData["ActiveNav"] = "latest-comments";
    var sr = 1;
}

<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span>/</span>
    <span>Latest Comments (Last 48 hours comments)</span>
</nav>

<header class="page-header">
    <h2>Latest Comments (Last 48 hours comments)</h2>
</header>

<section class="form-section" style="margin-top:16px;">
    <header class="form-section-header">Latest Comments List (Last 48 hours comments)</header>

    <div style="padding:15px;">
        <div class="table-wrap table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th width="5%">#</th>
                        <th width="12%">Booking No.</th>
                        <th width="12%">C-Name</th>
                        <th width="37%">Latest Comments</th>
                        <th width="12%">Booking Created By</th>
                        <th width="12%">Comments Created By</th>
                        <th width="10%">Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" style="text-align:center;">No comments in the last 48 hours.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@(sr++)</td>
                            <td>
                                <a asp-controller="Bookings" asp-action="ReadOnly" asp-route-id="@c.BookId"
                                   target="_blank" rel="noopener">@c.ReferenceNo</a>
                            </td>
                            <td>@c.CustomerName</td>
                            <td>@c.Comment</td>
                            <td>@c.BookingCreatedBy</td>
                            <td>@c.CommentCreatedBy</td>
                            <td>@c.CreatedDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="margin-top:12px;">Showing @Model.Count of @Model.Count.</div>
    </div>
</section>