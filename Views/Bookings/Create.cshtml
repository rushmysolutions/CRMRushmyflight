    <input data-field="TicketNo" />
</div>
</div>
</div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            const list = document.getElementById('passenger-list');
            const template = document.getElementById('passenger-template');
            const addBtn = document.getElementById('add-passenger');

            function reindexPassengers() {
                list.querySelectorAll('.passenger-block').forEach((block, index) => {
                    block.dataset.index = index;
                    const header = block.querySelector('.passenger-block-header strong');
                    if (header) header.textContent = 'Passenger ' + (index + 1);

                    block.querySelectorAll('[data-field]').forEach(el => {
                        const field = el.dataset.field;
                        el.name = 'Passengers[' + index + '].' + field;
                    });

                    block.querySelectorAll('input[type="hidden"][name^="Passengers"]').forEach(el => {
                        if (!el.dataset.field) {
                            el.name = 'Passengers[' + index + '].PassId';
                        }
                    });
                });
            }

            addBtn.addEventListener('click', function() {
                const clone = template.content.cloneNode(true);
                list.appendChild(clone);
                reindexPassengers();
            });

            list.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-passenger')) {
                    e.target.closest('.passenger-block').remove();
                    reindexPassengers();
                }
            });
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script>
        (function() {
            const source = document.getElementById('FlightPnr');
            const holder = document.getElementById('pnr-editor');
            const status = document.getElementById('pnr-status');
            const form = source ? source.closest('form') : null;
            if (!source || !holder || !form) return;

            // If the CDN fails, fall back to the plain textarea
            if (typeof Quill === 'undefined') {
                source.classList.remove('pnr-source');
                holder.remove();
                return;
            }

            // flight_info is a MySQL TEXT column: max 65,535 bytes. Keep a small margin.
            const MAX_BYTES = 65000;
            const MAX_IMAGE_SIZE = 5 * 1024 * 1024;
            const uploadUrl = '@Url.Action("UploadEditorImage")';
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            let pendingUploads = 0;
            let userChanged = false;
            const inFlight = new Set();

            function byteLength(text) {
                return new TextEncoder().encode(text).length;
            }

            function setStatus(message, isError) {
                status.textContent = message || '';
                status.classList.toggle('is-error', !!isError);
            }

            function editorHtml() {
                const hasText = quill.getText().trim().length > 0;
                const hasImage = !!quill.root.querySelector('img');
                return hasText || hasImage ? quill.root.innerHTML : '';
            }

            function sync() {
                if (!userChanged) return;   // untouched old content is posted back exactly as loaded
                source.value = editorHtml();
                const size = byteLength(source.value);
                if (size > MAX_BYTES) {
                    setStatus('Content is too large (' + Math.round(size / 1024) + ' KB of max 63 KB). Remove some text or images.', true);
                } else if (pendingUploads === 0) {
                    setStatus('');
                }
            }

            async function uploadFile(file) {
                if (!file.type || !file.type.startsWith('image/')) throw new Error('Only images are allowed.');
                if (file.size > MAX_IMAGE_SIZE) throw new Error('Image must be under 5 MB.');

                const fd = new FormData();
                fd.append('file', file, file.name || ('paste.' + (file.type.split('/')[1] || 'png')));
                if (tokenInput) fd.append('__RequestVerificationToken', tokenInput.value);

                const res = await fetch(uploadUrl, { method: 'POST', body: fd });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.url) throw new Error(data.error || 'Upload failed');
                return data.url;
            }

            async function uploadAndInsert(file, index) {
                pendingUploads++;
                setStatus('Uploading image...');
                try {
                    const url = await uploadFile(file);
                    userChanged = true;
                    quill.insertEmbed(index, 'image', url, 'user');
                    quill.setSelection(index + 1, 0, 'silent');
                } catch (err) {
                    setStatus('Image upload failed: ' + err.message, true);
                } finally {
                    pendingUploads--;
                    if (pendingUploads === 0 && !status.classList.contains('is-error')) setStatus('');
                    sync();
                }
            }

            // Images pasted as HTML (e.g. copied from a web page / email) arrive as base64.
            // Upload them and replace the base64 with a short URL.
            async function replaceBase64Images() {
                const images = Array.from(quill.root.querySelectorAll('img[src^="data:"]'));
                for (const img of images) {
                    const dataUrl = img.getAttribute('src');
                    if (inFlight.has(dataUrl)) continue;
                    inFlight.add(dataUrl);
                    pendingUploads++;
                    setStatus('Uploading image...');
                    try {
                        const blob = await (await fetch(dataUrl)).blob();
                        const url = await uploadFile(new File([blob], 'paste.' + (blob.type.split('/')[1] || 'png'), { type: blob.type }));
                        const blot = Quill.find(img);
                        if (blot) {
                            const index = quill.getIndex(blot);
                            quill.deleteText(index, 1, 'silent');
                            quill.insertEmbed(index, 'image', url, 'user');
                        }
                    } catch (err) {
                        const blot = Quill.find(img);
                        if (blot) quill.deleteText(quill.getIndex(blot), 1, 'user');
                        setStatus('Image removed, upload failed: ' + err.message, true);
                    } finally {
                        inFlight.delete(dataUrl);
                        pendingUploads--;
                        if (pendingUploads === 0 && !status.classList.contains('is-error')) setStatus('');
                        sync();
                    }
                }
            }

            const quill = new Quill(holder, {
                theme: 'snow',
                placeholder: 'Paste PNR data here...',
                modules: {
                    toolbar: {
                        container: [
                            [{ header: [false, 3, 4] }],
                            ['bold', 'italic', 'underline'],
                            [{ color: [] }, { background: [] }],
                            [{ list: 'ordered' }, { list: 'bullet' }],
                            ['link', 'image'],
                            ['clean']
                        ],
                        handlers: {
                            image: function() {
                                const input = document.createElement('input');
                                input.type = 'file';
                                input.accept = 'image/png,image/jpeg,image/gif,image/webp';
                                input.onchange = () => {
                                    const file = input.files[0];
                                    if (file) uploadAndInsert(file, quill.getSelection(true).index);
                                };
                                input.click();
                            }
                        }
                    },
                    // Screenshots pasted with Ctrl+V or dragged in go to the server, not base64
                    uploader: {
                        handler: function(range, files) {
                            files.forEach((file, i) => uploadAndInsert(file, range.index + i));
                        }
                    }
                }
            });

            // Load existing value on Edit (old PHP bookings keep their image URLs)
            const initial = source.value || '';
            if (/<[a-z][\s\S]*>/i.test(initial)) {
                quill.clipboard.dangerouslyPasteHTML(initial, 'silent');
            } else if (initial) {
                quill.setText(initial, 'silent');
            }

            quill.on('text-change', function(delta, oldDelta, changeSource) {
                if (changeSource !== 'user') return;
                userChanged = true;
                if (quill.root.querySelector('img[src^="data:"]')) replaceBase64Images();
                sync();
            });

            // Final guard: never post something MySQL will reject
            form.addEventListener('submit', function(e) {
                sync();
                let message = null;
                if (pendingUploads > 0) {
                    message = 'Please wait, image is still uploading.';
                } else if (source.value.indexOf('data:image') !== -1) {
                    message = 'An image could not be uploaded. Remove it and add it again.';
                } else if (byteLength(source.value) > MAX_BYTES) {
                    message = 'Flight information is too large. Remove some text or images.';
                }
                if (message) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    setStatus(message, true);
                    holder.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }, true);
        })();
    </script>
    <script>
        (function() {
            const ticket = document.getElementById('TicketCost');
            const mco = document.getElementById('McoAmount');
            const total = document.getElementById('TotalAmount');
            const net = document.getElementById('NetMco');
            if (!ticket || !mco || !total || !net) return;

            const RATE = @BookingAmountCalculator.McoDeductionPercent / 100;

            function num(v) {
                const n = parseFloat(String(v || '').replace(/[^0-9.\-]/g, ''));
                return isNaN(n) ? 0 : n;
            }
            function sumList(v) {
                return String(v || '').split(',').reduce((s, p) => s + num(p), 0);
            }
            function round2(n) {
                return (Math.round((n + Number.EPSILON) * 100) / 100).toFixed(2);
            }

            function recalc() {
                if (!ticket.value.trim() && !mco.value.trim()) {
                    total.value = '';
                    net.value = '';
                    return;
                }
                const t = sumList(ticket.value);
                const m = num(mco.value);
                net.value = round2(m - m * RATE);
                total.value = round2(t + m);
            }

            ticket.addEventListener('input', recalc);
            mco.addEventListener('input', recalc);
        })();
    </script>
}
