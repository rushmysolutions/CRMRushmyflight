        <div class="form-field">
            <label asp-for="Comment">Comments</label>
            <textarea asp-for="Comment" rows="3"></textarea>
        </div>
    </section>

    <div class="form-actions">
        <button type="submit" class="btn primary submit-booking">@(isEdit ? "Update and Go To Listing" : "Add and Go To Listing")</button>
        <a class="btn" asp-action="Index">Cancel</a>
