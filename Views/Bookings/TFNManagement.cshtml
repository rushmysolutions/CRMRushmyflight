@using RushMyBookings.Crm.Entities
@model IEnumerable<RushMyBookings.Crm.Entities.Tfn>

<nav class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span>/</span>
    <span>TFN Management</span>
</nav>

<header class="page-header d-flex justify-content-between align-items-center">
    <h2>TFN Management</h2>
    <a asp-action="TfnForm" class="btn btn-primary">➕ Add TFN</a>
</header>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<section class="form-section">
    <header class="form-section-header">TFN List</header>

    <div class="p-3" style="padding: 16px 16px 0">
        <div class="table-wrap table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle table-common-crm">
                <thead class="table-dark">
                    <tr>
                        <th style="width:50px">#</th>
                        <th>TFN Number</th>
                        <th>DID Number</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th style="width:120px">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sr = 1;
                    }
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@(sr++)</td>
                            <td class="fw-bold">@t.TfnNumber</td>
                            <td>@t.DidNumber</td>
                            <td>@(Tfn.Types.GetValueOrDefault(t.Type, t.Type))</td>
                            <td>
                                <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">
                                    @(t.IsActive ? "Active" : "In-Active")
                                </span>
                            </td>
                            <td class="d-flex gap-1">
                                <div class="flex-items-wrap">
                                    <a asp-action="TfnForm" asp-route-id="@t.TfnId"
                                       class="btn btn-sm btn-info text-white" title="Edit">✏️</a>

                                    <form asp-action="TfnDelete" asp-route-id="@t.TfnId" method="post"
                                          onsubmit="return confirm('Kya aap TFN @t.TfnNumber delete karna chahte hain?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete">🗑️</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">Koi TFN nahi mila</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-2 text-muted pagination-common-wrap">Showing @Model.Count() of @Model.Count().</div>
    </div>
</section>